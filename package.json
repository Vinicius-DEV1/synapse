{
  "name": "synapse-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/web-react"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@synapse/web-react",
    "test": "npm run test --workspace=@synapse/web-react --",
    "test:unit": "npm run test:unit --workspace=@synapse/web-react --",
    "test:coverage": "npm run test:coverage --workspace=@synapse/web-react --",
    "test:related": "npm run test:related --workspace=@synapse/web-react --",
    "typecheck": "npm run typecheck --workspace=@synapse/web-react",
    "build": "npm run build --workspace=@synapse/web-react",
    "build:web": "npm run build:web --workspace=@synapse/web-react",
    "lint": "npm run lint --workspace=@synapse/web-react",
    "preview": "npm run preview --workspace=@synapse/web-react",
    "tauri": "npm run tauri --workspace=@synapse/web-react --",
    "benchmark": "npm run benchmark --workspace=@synapse/web-react",
    "benchmark:scroll": "npm run benchmark:scroll --workspace=@synapse/web-react",
    "check:budgets": "npm run check:budgets --workspace=@synapse/web-react",
    "swarm:setup": "npm run swarm:setup --workspace=@synapse/web-react",
    "swarm:merge": "npm run swarm:merge --workspace=@synapse/web-react",
    "mobile-webview:start": "npm --prefix apps/mobile-webview run start",
    "mobile-webview:android": "npm --prefix apps/mobile-webview run android"
  }
}
