{
  "name": "caderno",
  "private": true,
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc -p tsconfig.electron.json -w\" \"wait-on tcp:127.0.0.1:35174 && cross-env NODE_ENV=development electron .\"",
    "build": "tsc -p tsconfig.electron.json && tsc && vite build && electron-builder",
    "build:web": "vite build --outDir dist-web",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.caderno.app",
    "productName": "Caderno",
    "directories": {
      "output": "dist-app"
    },
    "win": {
      "icon": "icon.png",
      "target": [
        "dir"
      ]
    },
    "asar": false,
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "icon.png"
    ]
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@journeyapps/sqlcipher": "^5.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@tiptap/extension-bubble-menu": "^3.27.1",
    "@tiptap/extension-collaboration": "^3.27.1",
    "@tiptap/extension-floating-menu": "^3.27.1",
    "@tiptap/extension-highlight": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/extension-task-item": "^3.27.1",
    "@tiptap/extension-task-list": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.19.1",
    "epubjs": "^0.3.93",
    "firebase": "^12.15.0",
    "htmldiff-js": "^1.0.5",
    "idb": "^8.0.3",
    "lucide-react": "^1.21.0",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-easy-crop": "^6.0.2",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sqlite3": "^3.1.11",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
