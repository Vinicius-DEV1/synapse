# ==============================================================================
# Synapse - Environment Configuration Template (.env.example)
#
# NOTE: All cloud sync and external API integrations are strictly OPTIONAL.
# Synapse operates 100% offline with zero cloud configuration.
# To activate cloud features, copy this file to .env and supply your credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Authentication & Firestore (E2EE Cloud Sync & Realtime Signaling)
# ------------------------------------------------------------------------------
# All data synced to Firestore is client-side encrypted with AES-256-GCM.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_SHARE_DOMAIN="synapse-dev.web.app"

# Optional: Local Firebase Emulator Suite (Offline Cloud Testing)
# VITE_USE_FIREBASE_EMULATOR="false"
# VITE_FIRESTORE_EMULATOR_HOST="127.0.0.1"
# VITE_FIRESTORE_EMULATOR_PORT="8080"
# VITE_AUTH_EMULATOR_URL="http://127.0.0.1:9099"

# ------------------------------------------------------------------------------
# 2. Google Drive Storage Integration (ENC1 Encrypted Media & Textbook Backups)
# ------------------------------------------------------------------------------
# Configured via Google Cloud Console (OAuth 2.0 Client ID with PKCE).
VITE_DRIVE_CLIENT_ID=""
# Client Secret is optional when using PKCE in public web/desktop clients
VITE_DRIVE_CLIENT_SECRET=""
# OAuth Redirect URI (Default Vite dev server runs on port 35174)
VITE_DRIVE_REDIRECT_URI="http://localhost:35174"

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Integration (Contextual Flashcards & Voice Immersion)
# ------------------------------------------------------------------------------
# Optional fallback API key if not configured directly in the in-app AI Settings.
VITE_GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 4. Optional Media & Development Endpoints
# ------------------------------------------------------------------------------
# YouTube Data API v3 (Optional fallback; falls back to Firebase API Key if empty)
# VITE_YOUTUBE_API_KEY=""

# Culture sync endpoint (Optional)
# VITE_CULTURE_SYNC_URL=""

# Local share testing flag (Set to 'true' during local development of share viewer)
# VITE_USE_LOCAL_SHARE_URL="false"
