import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15

Dialog {
    id: helpRoot
    anchors.centerIn: parent
    width: Math.min(parent.width - 32, 720)
    height: Math.min(parent.height - 32, 450)
    modal: true
    title: qsTr("Notes guide")
    visible: isOpen
    property bool isOpen: false
    property int section: 0

    contentItem: RowLayout {
        spacing: 20
        ColumnLayout {
            Layout.preferredWidth: 170
            Layout.fillHeight: true
            Button { Layout.fillWidth: true; text: qsTr("Editing"); highlighted: helpRoot.section === 0; onClicked: helpRoot.section = 0 }
            Button { Layout.fillWidth: true; text: qsTr("Pages"); highlighted: helpRoot.section === 1; onClicked: helpRoot.section = 1 }
            Button { Layout.fillWidth: true; text: qsTr("Shortcuts"); highlighted: helpRoot.section === 2; onClicked: helpRoot.section = 2 }
            Item { Layout.fillHeight: true }
            Button { Layout.fillWidth: true; text: qsTr("Close"); onClicked: helpRoot.close() }
        }
        Text {
            Layout.fillWidth: true
            Layout.fillHeight: true
            color: "#fffffe"
            wrapMode: Text.Wrap
            lineHeight: 1.4
            text: helpRoot.section === 0
                ? qsTr("Open a page and select Edit. Use the mode button beside the guide to switch between source and visual editing. Type / to open the comprehensive native block menu supporting 31 block types: text, headings 1–3, task lists, bulleted lists, callouts, code blocks, page references, child-page creation, dividers, structured tables (standard 3x3, weekly 4x7 with day headers, daily schedule 8x2, and habit matrix 5x8), 2-column and 3-column layouts, collapsible toggle blocks, callout toggles, interactive quiz question batteries, Pomodoro focus timers, scheduled alarms, calendar agenda events, daily habits, attached file widgets, document bundles, offline web snapshot cards, collection groups, video links, book links, and AI request cards. Choose Link to page to search active page titles and normalized note text, or Create linked page to create a child under the current page and insert its reference at the saved caret without leaving the current note. Search is debounced; encrypted page text is searched only while the vault is unlocked, while title matches remain available when it is locked. Active references use a muted inline link marker; a missing target appears in red with a Deleted label. Activating an active reference opens a floating page preview; use Expand to open it in the main Notes view. The preview closes with Escape, its close button, or a click outside. Choose Edit in the preview to update its title, description, and content directly, and choose Save to persist changes to the database and refresh the page tree; Cancel reverts unsaved preview edits. Backspace or Delete on a reference asks before removing it; the removal can be undone. Clicking a missing or trashed reference offers Keep or Remove. In reading preview mode, all embedded widgets (quiz batteries with option gabarito, Pomodoro timers, alarms, calendar events, habit trackers, attached files, toggles, multi-columns, scraps, document bundles, video links, book links, and collection groups) render as high-fidelity visual cards with full React TipTap schema compatibility, including interactive toggle and collection expansion and click-to-reveal spoilers. Search by typing, use Up/Down and Enter to choose, or close with Esc, Left/Right, or Space; Space is inserted in the document. The slash query and selected block action form one undo step. Visual editing supports paragraphs, headings 1–6, plain horizontal dividers, simple uniform tables with a header row, body rows, subtle borders, padded cells, a shaded header, and a table palette for setting or clearing the background on the active cell, current row, current column, or entire table. The adjacent selection controls select the current row, column, or entire table; merged cells expand to keep whole cell boundaries, and the toolbar highlights the current selection scope. Select a rectangular range in the same header or body section and choose Merge or split cells to merge it; choose the action again from a merged cell to split it. With a rectangular selection across cells in the same table, choose Clear formatting to remove inline marks in those cells while preserving text, cell backgrounds, merged spans, and header semantics; the change is one undo step. Merged content stays together and React-compatible row and column spans save with the note, bulleted and numbered lists with keyboard nesting and outdent, standard quotations with a contextual palette for nine React callout colors and a default reset, code blocks with an Auto option and the registered React language list; use Copy in the code header to copy its plain text and line breaks, with a brief success state, or use Add Paragraph to continue editing immediately below the block. Delete asks for confirmation, removes every line in the block, and can be undone. Use the up/down arrows to move the whole code group past a compatible paragraph, heading, or callout; the controls disable at document edges and leave lists, dividers, images, and other code blocks in place. Drag the ⋮⋮ grip to drop the whole code block before or after a compatible paragraph, heading, or callout. Bold, italic, underline, strike, inline code, and spoiler marks. With the caret and no selection, toggle a mark to apply it to text typed next; toggle it again to cancel. With selected text, the mark applies to that selection. Text color, highlights, and safe http, https, or mailto links. Code language labels save with the block. Native syntax colors currently cover common keywords, strings, comments, numbers, function names, markup tags, and diff lines; changing the language or using keyboard undo/redo refreshes the colors without changing saved HTML. Click hidden spoiler text to reveal it, Alt+click to toggle it, and double-click to hide it again. For keyboard access, place the caret in spoiler text and press Alt+R; a checkbox appears beside the caret, where Space toggles reveal state and Escape returns to the editor. The checkbox exposes its checked state to assistive technology. In a list, Tab nests the current item under its preceding sibling and Shift+Tab outdents a nested item; either shortcut moves the whole item and its nested lists from any direct paragraph. Bullet and numbered list items can contain multiple direct paragraphs before and after nested lists. For task lists, click a checkbox, move the caret to its marker and press Space, or Tab to a checkbox when list indentation does not apply; a focused checkbox toggles with Space and exposes all task paragraphs and checked state to assistive technology. Task items can contain multiple direct paragraphs, and checking an item dims and strikes through all of them. Block actions apply to the current block or every block touched by the selection. Select text and open the A palette to choose a text or highlight color. Use the link action to add, edit, or remove a link. Unsupported structures such as resized tables, merges crossing a header/body boundary, malformed table spans, and custom table metadata stay in source mode so their markup is preserved. Undo unsupported pasted formatting before saving, previewing, or leaving the page. The visual toolbar inserts a horizontal divider, a task list, and structured tables. In visual mode, choose Insert image to add a local PNG, JPEG, GIF, WebP, or BMP file up to 2 MiB and 30 megapixels; convert SVG, AVIF, ICO, or TIFF files first. Qt stores the validated image data in the page body, centers it, limits its display width to 720 pixels, and uses the file name as alt text. Insertion can be undone. Place the caret on an image to show left, center, and right alignment controls; edit its caption in the field below the image. Alignment and caption changes save as React-compatible data-align and data-caption attributes and can each be undone. Drag the southeast corner or a side handle to resize an image; the image preview stays local until you release, and the size change is one undo step. Hold Shift while dragging to resize without preserving the aspect ratio. Press Escape or cancel the pointer gesture to discard the preview, and double-click any resize handle to restore natural dimensions. Use Fit to editor width or Reset image size in the formatting toolbar to resize or restore the image. Move the selected image up or down across a compatible neighboring block; the controls disable at document or rich-structure boundaries. Add paragraph inserts a focused editable paragraph directly below the image. Each move or paragraph insertion is one undo step. To paste an image, copy it and press Ctrl/Cmd+V in a regular paragraph. Select an existing image and paste to insert after it. Clipboard images are embedded in the note body and must meet the 2 MiB and 30-megapixel limits. Shift+Ctrl/Cmd+V, ordinary text, and paste inside a code block keep their normal editor behavior. You can also drop up to 20 local PNG, JPEG, GIF, WebP, or BMP image files onto a regular paragraph to insert them in file order at that position. Clipboard path lists also insert up to 20 supported local images in order; a direct bitmap clipboard payload inserts one image. Each file is checked independently against the 2 MiB and 30-megapixel limits, and skipped invalid files are reported. Batch insertion is one undo step. Copy sends a PNG version to the system clipboard. Download opens a save dialog, suggests a caption-based filename, and preserves the embedded raster format. Double-click a selected image or choose View or crop image to open the full-screen viewer. Use the wheel or the 50%–500% zoom slider in view mode; choose Crop, drag to draw a free-aspect crop, and Shift-drag or right-drag to move the image. Cancel returns to viewing without changing the note. Save crop applies a JPEG replacement in one undo step, keeps alt text, title, caption, and alignment, and clears explicit dimensions. At an image edge, Backspace or Delete first selects the image; repeat the key to open a deletion confirmation. Escape cancels, while Enter, Backspace, or Delete confirms. The image toolbar offers the same confirmation, and undo restores a deleted image. When the caret is in a table, use contextual controls to add, move, or delete rows and columns. Insertion, movement, and deletion work across merged cells, adjust their positions and spans, and preserve cell content and backgrounds; a selected row or column range is applied as one undoable change. You can split cells or delete the whole table in a merged table. Use the adjacent table palette to set or clear the background on the active cell, current row, current column, or entire table. When a complete rectangular range inside one table is selected, the palette also offers Selection to color exactly those cells. Cross-table selections and ranges that cut through only part of a merged cell are ignored. Move controls disable at table edges; moving the header row preserves its header styling and saved header-cell semantics. The final row or column cannot be deleted. When the caret is on a divider, use its contextual controls to move it up or down across an adjacent compatible block, add a paragraph below it, or drag the grip before or after a compatible block in the same region. Drops across lists, frames, or different table cells are rejected. Movement disables at document and structural boundaries. In source mode, the formatting toolbar and context menu can insert headings, lists, dividers, custom tables, and custom widget blocks; edit table cells and widgets directly in the source. Applying the same inline format again removes matching markup. Undo and redo restore each formatting or link insertion as one action. Preview renders supported content, embedded custom widgets, and saved React link-preview blocks as native cards with their saved title and channel. Missing title, channel, duration, and playlist count can be filled from the local link metadata cache; a missing title falls back to the validated HTTP(S) host. Unsafe targets show an unavailable state. In the reading preview, use Mark as watching/Stop watching and Mark as completed/Mark as not completed to save shared Link Vault status and React-compatible block attributes. Use Copy URL to place the validated destination on the system clipboard; the card changes to Copied as feedback. Convert to text replaces only that card with its validated URL as a link, and the change can be undone. Show link notes to reveal saved block or Link Vault notes; Edit link notes opens a keyboard-accessible dialog, where Clear empties the field and Save updates the card and shared Link Vault record. Use Change link color to select one of nine colors or reset to Default; the selected card and shared Link Vault record update together. Choose Delete link card to open a confirmation dialog and remove the card from the document in one undo step. The Link actions button opens a keyboard-accessible menu for the same card actions. Direct card links remain mouse-activated. Changes save automatically; use Save to retry if saving fails. If external edits are detected from another client while local edits are pending, your changes are safely archived in page history to prevent data loss.")
                : helpRoot.section === 1
                ? qsTr("Create pages and subpages, move them through the page actions, and open History to inspect saved revisions. Use Link to page to reference an existing page, or Create linked page to add a child page under the current note without navigating away. Activating a reference opens a floating preview where you can view or edit the page title, description, and content, or choose Expand to move to the full page. Moving a page to Trash includes its active descendants.")
                : qsTr("Ctrl/Cmd+S: save\nCtrl/Cmd+E: toggle preview\nCtrl/Cmd+B: toggle bold\nCtrl/Cmd+I: toggle italic\nCtrl/Cmd+U: toggle underline\nCtrl/Cmd+Shift+X: toggle strikeout\nCtrl/Cmd+Shift+S: toggle spoiler\n/: open block menu\nUp/Down: move through matches\nEnter: apply selected block\nEsc: close menu\nLeft/Right: close menu and move the caret\nSpace: close menu and insert a space\n\nEditor shortcuts are disabled while an editor dialog is open.")
        }
    }
}
