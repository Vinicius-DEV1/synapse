    <string name="module_help_action">Guide</string>
    <string name="culture_help_title">Culture guide</string>
    <string name="culture_help_catalog">Catalog</string>
    <string name="culture_help_catalog_body">Use the type, status, goal, and search filters to find films, series, anime, books, and other tracked media. Add an item to keep it in this device’s catalog.</string>
    <string name="culture_help_progress">Progress</string>
    <string name="culture_help_progress_body">Edit the item to update its title, type, progress, total, cover, synopsis, access link, or goal. Episode checklists are stored through Core. Ratings and recommendations are not available in this Android screen.</string>
    <string name="culture_help_data">Data</string>
    <string name="culture_help_data_body">Culture records are stored locally on this device. API discovery, cloud sync, and encryption are not implemented in Android.</string>
    <string name="habits_help_title">Habits guide</string>
    <string name="habits_help_tracking">Daily tracking</string>
    <string name="habits_help_tracking_body">Create a habit, choose its category, and check it in each day. The overview shows today’s completion and the current streak calculated by Core.</string>
    <string name="habits_help_categories">Categories and history</string>
    <string name="habits_help_categories_body">Filter the list by category and review the recent days. The full heatmap, note widget selector, and expanded statistics are not available in Android yet.</string>
    <string name="habits_help_data">Data</string>
    <string name="habits_help_data_body">Habits and check-ins are stored locally through synapse-core. This Android flow does not sync or encrypt habit records.</string>
    <string name="library_help_title">Library guide</string>
    <string name="library_help_catalog">Catalog and collections</string>
    <string name="library_help_catalog_body">Add book metadata, organize books into collections, filter by reading status, and archive or restore a title. The Android catalog does not import book files yet.</string>
    <string name="library_help_progress">Reading progress</string>
    <string name="library_help_progress_body">Use the book actions to update page progress and reading status. Aggregate page totals come from Core; there is no Android PDF or EPUB reader yet.</string>
    <string name="library_help_annotations">Bookmarks and highlights</string>
    <string name="library_help_annotations_body">The notebook stores manual bookmarks and highlights by page number. It is not connected to selected text in a document, and Android does not encrypt these annotations at rest.</string>
    <string name="questions_help_title">Questions guide</string>
    <string name="questions_title">Questions</string>
    <string name="questions_subtitle">Batteries, simulations, and error review</string>
    <string name="questions_help_batteries">Batteries</string>
    <string name="questions_help_batteries_body">Create a battery, add multiple-choice questions, then open a battery to study. Question and answer data are validated and stored by Core.</string>
    <string name="questions_help_simulations">Simulations</string>
    <string name="questions_help_simulations_body">Choose question tags and status, set a question limit, and shuffle before starting a simulation. Correctness and attempt persistence are handled by Core.</string>
    <string name="questions_help_history">History and limits</string>
    <string name="questions_help_history_body">Review recent attempts or open a question’s attempt history from its management panel. Open-answer formats, the separate filtered battery browser, and richer analytics are not available yet.</string>
    <string name="vault_help_action">Vault security guide</string>
    <string name="vault_title">Password vault</string>
    <string name="vault_help_title">Vault availability and security</string>
    <string name="vault_help_status">Current status</string>
    <string name="vault_help_status_body">Credentials are not available in this Android build. The screen does not save or load password entries until an Android key lifecycle and encrypted Core store are implemented.</string>
    <string name="vault_help_security">Security boundary</string>
    <string name="vault_help_security_body">Core Vault CRUD stores the values it receives as-is. Android therefore keeps credential writes disabled instead of sending plaintext secrets to the database.</string>
    <string name="vault_help_data">Data and migration</string>
    <string name="vault_help_data_body">A safe implementation needs compatible key ownership, atomic encryption of credentials and password history, and memory clearing on lock. Android account migration, sync, and encrypted export are not available.</string>
    <string name="trash_help_title">Trash guide</string>
    <string name="trash_help_browse">Browse deleted items</string>
    <string name="trash_help_browse_body">Use the category filters to narrow the deleted records shown here. The count in the header includes every item in Trash, including records outside the selected filter.</string>
    <string name="trash_help_restore">Restore an item</string>
    <string name="trash_help_restore_body">Choose Restore on an item card to return it to its original module. Notes and linked calendar data follow the Core restore operation.</string>
    <string name="trash_help_delete">Delete permanently</string>
    <string name="trash_help_delete_body">Permanent deletion and Empty Trash require confirmation and cannot be undone. When Lofi audio is present, Android disables emptying and directs you to React because provider-owned audio cleanup is not supported here.</string>
    <string name="trash_help_data">Data and file access</string>
    <string name="trash_help_data_body">Trash records are stored locally through synapse-core. Android does not sync or encrypt these records yet. File and audio provider access is retained for restore and released after permanent deletion when no other Core record uses the URI.</string>
</resources>
